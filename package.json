{
  "name": "local-logger",
  "version": "0.1.0",
  "description": "A capped, persistent on-device log for browser diagnostics reports, kept in localStorage so it survives reloads, app updates, and a phone killing a backgrounded tab. Framework-agnostic, with optional React hooks.",
  "keywords": [
    "logger",
    "logging",
    "localstorage",
    "diagnostics",
    "breadcrumbs",
    "offline-first",
    "pwa",
    "react",
    "react-hooks"
  ],
  "author": "Blake Vandercar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/local-logger.git"
  },
  "homepage": "https://github.com/bvandrc/local-logger#readme",
  "bugs": "https://github.com/bvandrc/local-logger/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome check . --fix",
    "lint": "biome check .",
    "ts:check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolated": "vitest run --isolate",
    "check": "pnpm run ts:check && pnpm run lint",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^18",
    "happy-dom": "^21",
    "react": "^18",
    "react-dom": "^18",
    "tsdown": "^0.23",
    "typescript": "^7",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0"
}
